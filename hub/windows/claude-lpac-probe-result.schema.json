{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-hub:claude-lpac-probe-result:1",
  "title": "Synthetic W0 controller result, never provider readiness",
  "$comment": "The top-level envelope is closed. events and extra case evidence are explicitly bounded JSON metadata, not commands or authority. A real W0 manifest must also reconcile the separately measured fixed Claude static identity. No result establishes all Windows escape classes, provider readiness, hard disk quota or signed attestation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "stage", "code", "nativeCode", "bootstrapPassed", "cleanupVerified", "probePassed", "providerReady", "profileCreated"],
  "allOf": [{"anyOf": [{"properties": {"bootstrapPassed": {"const": false}}}, {"required": ["lpacTokenProof"]}]}],
  "properties": {
    "schemaVersion": {"const": 1},
    "operation": {"const": "claude-lpac-bootstrap-gate"},
    "stage": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "code": {"$ref": "#/$defs/code"},
    "nativeCode": {"$ref": "#/$defs/nativeCode"},
    "bootstrapPassed": {"type": "boolean"},
    "cleanupVerified": {"type": "boolean"},
    "probePassed": {"const": false},
    "providerReady": {"const": false},
    "profileCreated": {"type": ["boolean", "null"]},
    "lpacTokenProof": {"$ref": "#/$defs/lpacTokenProof"},
    "clrActivationLogs": {"$ref": "#/$defs/clrActivationLogs"},
    "executionSwitch": {"const": "--execute-approved-w0-gate"},
    "runNonceFormat": {"const": "32 lowercase hex"},
    "fixtureName": {"const": "claude-lpac-fixture.exe"},
    "runNonce": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 32, "maxLength": 32, "pattern": "^[a-f0-9]{32}$"}]},
    "root": {"$ref": "#/$defs/pathOrNull"},
    "journalPath": {"$ref": "#/$defs/pathOrNull"},
    "profileFolder": {"$ref": "#/$defs/pathOrNull"},
    "profileName": {"type": ["string", "null"], "maxLength": 64},
    "registryStorage": {"$ref": "#/$defs/pathOrNull"},
    "creationAttempted": {"type": "boolean"},
    "creationOutcomeKnown": {"type": "boolean"},
    "modelCalled": {"const": false},
    "authRead": {"const": false},
    "networkProbed": {"type": "boolean"},
    "wholeProcessIsolationVerified": {"const": false},
    "diskQuotaEnforced": {"const": false},
    "syntheticSuiteComplete": {"type": "boolean"},
    "reservedCaseRoots": {"type": "integer", "minimum": 0, "maximum": 12},
    "reservedPossibleSuccesses": {"type": "integer", "minimum": 0, "maximum": 32},
    "reservedStartAttempts": {"type": "integer", "minimum": 0, "maximum": 48},
    "observedRootStarts": {"type": "integer", "minimum": 0, "maximum": 12},
    "observedChildStarts": {"type": "integer", "minimum": 0, "maximum": 32},
    "fixtureExitCode": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "stdoutBytes": {"type": "integer", "minimum": 0, "maximum": 65536},
    "stderrBytes": {"type": "integer", "minimum": 0, "maximum": 65536},
    "measuredFolderBytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "diskMeasurementScope": {"const": "owned-temp-and-profile-folder-files; registry-hive-allocation-not-attributed; soft-budget-only"},
    "cleanupCode": {"$ref": "#/$defs/code"},
    "cleanupNativeCode": {"$ref": "#/$defs/nativeCode"},
    "events": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/evidenceObject"}},
    "cases": {"type": "array", "maxItems": 13, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "clrActivationLog": {
      "$comment": "Diagnostic bytes only, never commands or authority. Consumers must decode the bounded base64 and check its byte count and SHA; JSON Schema does not prove their equality.",
      "type": "object", "additionalProperties": false,
      "required": ["sourceBasename", "sourceFileId", "bytes", "sha256", "rawBase64"],
      "properties": {
        "sourceBasename": {"type": "string", "pattern": "^claude-lpac-fixture\\.exe\\.CLRLoad[0-9]{2}\\.log$", "minLength": 37, "maxLength": 37},
        "sourceFileId": {"type": "string", "pattern": "^[a-f0-9]{8}:[a-f0-9]{16}$", "minLength": 25, "maxLength": 25},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$", "minLength": 64, "maxLength": 64},
        "rawBase64": {"type": "string", "maxLength": 87384, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$", "not": {"pattern": "[\\r\\n]"}}
      }
    },
    "clrActivationLogs": {
      "$comment": "At most two 64KiB source files (128KiB total); limits concern collection, not a hard shim write quota. Absent/error is not an activation cause or pass. Present only after an identity launch reached collection; historical results remain readable.",
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "scope", "status", "code", "interpretation", "logs"],
      "properties": {
        "schemaVersion": {"const": 1}, "scope": {"const": "identity-child-owned-tmp"},
        "status": {"enum": ["captured", "absent", "error"]}, "code": {"$ref": "#/$defs/code"},
        "interpretation": {"const": "diagnostic-only-not-root-cause-or-pass"},
        "logs": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/clrActivationLog"}}
      },
      "oneOf": [
        {"properties": {"status": {"const": "captured"}, "code": {"const": "CLR_LOGS_CAPTURED"}, "logs": {"minItems": 1}}},
        {"properties": {"status": {"const": "absent"}, "code": {"const": "CLR_LOGS_ABSENT"}, "logs": {"maxItems": 0}}},
        {"properties": {"status": {"const": "error"}, "code": {"not": {"enum": ["CLR_LOGS_CAPTURED", "CLR_LOGS_ABSENT"]}}, "logs": {"maxItems": 0}}}
      ]
    },
    "accessControl": {
      "type": "object", "additionalProperties": false,
      "required": ["functionSucceeded", "accessStatus", "grantedMask", "nativeCode", "privilegeSetCapacity", "privilegeSetReturnedBytes", "privilegeCount"],
      "properties": {
        "functionSucceeded": {"const": true}, "accessStatus": {"const": true},
        "grantedMask": {"enum": [2, 3]}, "nativeCode": {"const": 0},
        "privilegeSetCapacity": {"const": 4096},
        "privilegeSetReturnedBytes": {"type": "integer", "minimum": 8, "maximum": 4096},
        "privilegeCount": {"const": 0}
      }
    },
    "ownerAccessControl": {"allOf": [{"$ref": "#/$defs/accessControl"}, {"properties": {"grantedMask": {"const": 3}}}]},
    "lpacAccessControl": {"allOf": [{"$ref": "#/$defs/accessControl"}, {"properties": {"grantedMask": {"const": 2}}}]},
    "class46Observation": {
      "type": "object", "additionalProperties": false,
      "required": ["api", "informationClass", "capacity", "queryUnavailable", "nativeCode", "returnedBytes", "value"],
      "properties": {
        "api": {"const": "GetTokenInformation"}, "informationClass": {"const": 46}, "capacity": {"const": 4},
        "queryUnavailable": {"type": "boolean"}, "nativeCode": {"enum": [0, 87]},
        "returnedBytes": {"enum": [null, 4]}, "value": {"enum": [null, 1]}
      },
      "oneOf": [
        {"properties": {"queryUnavailable": {"const": true}, "nativeCode": {"const": 87}, "returnedBytes": {"const": null}, "value": {"const": null}}},
        {"properties": {"queryUnavailable": {"const": false}, "nativeCode": {"const": 0}, "returnedBytes": {"const": 4}, "value": {"const": 1}}}
      ]
    },
    "hasRestrictionsQuery": {
      "type": "object", "additionalProperties": false,
      "required": ["api", "informationClass", "returnedBytes", "encoding", "validationScope", "value"],
      "properties": {
        "api": {"const": "GetTokenInformation"}, "informationClass": {"const": 21},
        "returnedBytes": {"const": 1}, "encoding": {"const": "BOOLEAN-1"},
        "validationScope": {"const": "measured-host-abi-v1"}, "value": {"type": "boolean"}
      }
    },
    "lpacTokenProof": {
      "type": "object", "additionalProperties": false,
      "required": ["appContainerSid", "ownerSidMatched", "capabilityCount", "lowIntegrity", "primaryToken", "hasRestrictions", "hasRestrictionsQuery", "validationMethod", "referenceRevision", "ownerControl", "lpacAccess", "class46", "lpac"],
      "oneOf": [
        {"properties": {"hasRestrictions": {"const": false}, "hasRestrictionsQuery": {"properties": {"value": {"const": false}}}}},
        {"properties": {"hasRestrictions": {"const": true}, "hasRestrictionsQuery": {"properties": {"value": {"const": true}}}}}
      ],
      "properties": {
        "appContainerSid": {"type": "string", "minLength": 1, "maxLength": 184, "pattern": "^S-1-15-2(?:-[0-9]{1,10}){7}$"},
        "ownerSidMatched": {"const": true}, "capabilityCount": {"const": 0},
        "lowIntegrity": {"const": true}, "primaryToken": {"const": true},
        "hasRestrictions": {"type": "boolean"}, "lpac": {"const": true},
        "hasRestrictionsQuery": {"$ref": "#/$defs/hasRestrictionsQuery"},
        "validationMethod": {"const": "chromium-access-check-v1"},
        "referenceRevision": {"const": "5c210565c3fa181730df37778d22af487a0d5e40"},
        "ownerControl": {"$ref": "#/$defs/ownerAccessControl"},
        "lpacAccess": {"$ref": "#/$defs/lpacAccessControl"},
        "class46": {"$ref": "#/$defs/class46Observation"}
      }
    },
    "code": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Z][A-Z0-9_]*$"},
    "nativeCode": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
    "pathOrNull": {"type": ["string", "null"], "maxLength": 32768},
    "evidence": {
      "oneOf": [
        {"type": ["null", "boolean"]},
        {"type": "number", "minimum": -9007199254740991, "maximum": 9007199254740991},
        {"type": "string", "maxLength": 32768},
        {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/evidence"}},
        {"$ref": "#/$defs/evidenceObject"}
      ]
    },
    "evidenceObject": {
      "type": "object", "maxProperties": 128,
      "propertyNames": {"type": "string", "maxLength": 128, "not": {"enum": ["__proto__", "constructor", "prototype"]}},
      "additionalProperties": {"$ref": "#/$defs/evidence"}
    },
    "case": {
      "type": "object", "required": ["name", "status"], "maxProperties": 128,
      "properties": {
        "name": {"enum": ["identity", "functional", "brokers", "control", "tree-stop", "tree-eof", "memory", "process", "cpu", "wall", "stdout", "stderr", "claude-static-identity"]},
        "status": {"enum": ["pass", "fail", "not-measured"]},
        "code": {"$ref": "#/$defs/code"}
      },
      "propertyNames": {"type": "string", "maxLength": 128, "not": {"enum": ["__proto__", "constructor", "prototype"]}},
      "additionalProperties": {"$ref": "#/$defs/evidence"}
    }
  }
}
