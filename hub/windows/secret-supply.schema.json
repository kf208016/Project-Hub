{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Project Hub private selected-secret lease",
  "description":"Hash/FileID/root-bound binary supply; values never enter the journal. Ten-minute expiry stops the owned run before cleanup. Source originals and Git history are retained; no claim of blocking wider host reads.",
  "type":"object",
  "required":["version","id","at","expiresAt","project","task","taskHash","runId","base","dir","mode","sourceRootFingerprint","rootFingerprint","state","complete","files","error"],
  "properties":{
    "version":{"const":1},"id":{"type":"string","format":"uuid"},"at":{"type":"integer","minimum":0},"expiresAt":{"type":"integer","minimum":0},
    "project":{"$ref":"#/$defs/id"},"task":{"$ref":"#/$defs/id"},"taskHash":{"type":"string"},"runId":{"type":"string","minLength":1},"base":{"type":"string","minLength":1},"dir":{"type":"string","minLength":1},"mode":{"enum":["direct","isolated"]},
    "sourceRootFingerprint":{"$ref":"#/$defs/hash"},"rootFingerprint":{"$ref":"#/$defs/hash"},"state":{"enum":["planned","supplying","ready","stopping","cleaning","complete","failed"]},"complete":{"type":"boolean"},"error":{"type":"string"},
    "files":{"type":"array","maxItems":128,"items":{"type":"object","required":["relative","bytes","sourceHash","sourceFingerprint","tracked","state","error"],"properties":{"relative":{"type":"string","minLength":1},"bytes":{"type":"integer","minimum":0,"maximum":8388608},"sourceHash":{"$ref":"#/$defs/hash"},"sourceFingerprint":{"$ref":"#/$defs/hash"},"sha256":{"$ref":"#/$defs/hash"},"fileFingerprint":{"$ref":"#/$defs/hash"},"baseline":{"type":"object","required":["root","rootFingerprint","path","sha256","originalFingerprint","state"],"properties":{"root":{"type":"string"},"rootFingerprint":{"$ref":"#/$defs/hash"},"path":{"type":"string","pattern":"^[a-f0-9]{64}\\.key$"},"sha256":{"$ref":"#/$defs/hash"},"originalFingerprint":{"$ref":"#/$defs/hash"},"fileFingerprint":{"$ref":"#/$defs/hash"},"state":{"enum":["copying","ready","removing","removed"]}},"additionalProperties":false},"tracked":{"type":"boolean"},"state":{"enum":["planned","copying","copied","removing","removed","restoring","restored","resident","complete","failed"]},"error":{"type":"string"}},"additionalProperties":false}}
  },
  "$defs":{"id":{"type":"string","minLength":1,"pattern":"^[^\\\\/\\u0000]+$"},"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}},
  "additionalProperties":false
}
