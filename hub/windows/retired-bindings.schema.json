{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-hub/retired-bindings/v1",
  "title": "Native session retirement history emitted by retire",
  "description": "Local metadata history, not authority to resume an old ID. The metadata reader preserves unknown extension fields; this schema describes records emitted by retire.",
  "type": "array",
  "maxItems": 8,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["actor", "providerSessionId", "code", "at"],
    "properties": {
      "actor": {"enum": ["claude", "grok"]},
      "providerSessionId": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
      "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
      "at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"}
    }
  }
}
