{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-hub/provider-native-bridge/v1",
  "title": "Internal native CLI completion, owner approval, diagnostic or passive watcher ACK",
  "$comment": "Schema does not prove credential protection, account identity, OS policy, owner consent, task success or installed Hub readiness. The owner supplies an admitted exclusive endpoint. Internal onSession must synchronously persist the exact scoped binding before prompt submission; failure or a Promise refuses the turn. Missing required cleanup receipt retains controller and workspace ownership. A local receipt is not external attestation.",
  "oneOf": [{"$ref": "#/$defs/completion"}, {"$ref": "#/$defs/approval"}, {"$ref": "#/$defs/responseDiagnostic"}, {"$ref": "#/$defs/watcherAck"}, {"$ref": "#/$defs/watcherSummary"}],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "scope": {"type": "string", "minLength": 1, "maxLength": 32760, "pattern": "^[^\u0000]*$"},
    "completion": {
      "type": "object", "additionalProperties": false,
      "required": ["responseComplete", "cleanupVerified", "sessionId", "errorCode", "cancelled"],
      "properties": {
        "responseComplete": {"type": "boolean"}, "cleanupVerified": {"type": "boolean"},
        "sessionId": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "errorCode": {"type": ["string", "null"], "pattern": "^(CLAUDE|GROK)_NATIVE_[A-Z_]+$"},
        "cancelled": {"type": "boolean"}
      },
      "allOf": [{"if": {"properties": {"responseComplete": {"const": true}}},
        "then": {"properties": {"cleanupVerified": {"const": true}, "cancelled": {"const": false}, "errorCode": {"type": "null"}, "sessionId": {"$ref": "#/$defs/id"}}}}]
    },
    "watcherAck": {
      "$comment": "Only the two fixed native watcher ACKs are discarded as inert. They never resolve a client RPC or authorize any operation. Runtime additionally rejects negative zero. Unrecognized, extra, partial and error shapes remain rejected.",
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "result"],
      "properties": {"jsonrpc": {"const": "2.0"}, "id": {"enum": ["skills-reload", "workflows-reload"]},
        "result": {"type": "object", "additionalProperties": false, "required": ["result"],
          "properties": {"result": {"type": "object", "additionalProperties": false, "required": ["reloaded"],
            "properties": {"reloaded": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}}}}}
    },
    "watcherSummary": {
      "$comment": "Local descriptive counters, not a tool execution or reload permission. Runtime also limits the combined count to 64 per endpoint.",
      "type": "object", "additionalProperties": false, "required": ["skills", "workflows"],
      "properties": {"skills": {"type": "integer", "minimum": 0, "maximum": 64},
        "workflows": {"type": "integer", "minimum": 0, "maximum": 64}}
    },
    "responseDiagnostic": {
      "$comment": "Internal lastResponseDiagnostic only. Shape labels do not establish a response source, authority or success. Unknown and duplicate IDs remain rejected; no raw ID, payload or message is recorded.",
      "type": "object", "additionalProperties": false,
      "required": ["version", "idType", "idRelation", "responseKind", "resultShape", "errorCode", "pendingMethods"],
      "properties": {
        "version": {"const": 1}, "idType": {"enum": ["string", "number", "invalid"]},
        "idRelation": {"enum": ["pending", "already-replied", "server-request", "unknown"]},
        "responseKind": {"enum": ["result", "error", "invalid"]},
        "resultShape": {"enum": ["mcp-initialize", "acp-initialize", "acp-session", "acp-stop", "other", "none"]},
        "errorCode": {"type": ["integer", "null"], "minimum": -9007199254740991, "maximum": 9007199254740991},
        "pendingMethods": {"type": "array", "uniqueItems": true, "maxItems": 5,
          "items": {"enum": ["initialize", "session/new", "session/load", "session/set_model", "session/prompt"]}}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["token", "kind", "reason", "detail", "expiresAt", "project", "task", "runId", "sessionId"],
      "properties": {
        "token": {"type": "string", "format": "uuid"}, "kind": {"const": "tool"},
        "reason": {"type": "string", "maxLength": 256}, "detail": {"type": "string", "maxLength": 131072},
        "expiresAt": {"type": "integer", "minimum": 0}, "project": {"$ref": "#/$defs/scope"},
        "task": {"$ref": "#/$defs/scope"}, "runId": {"$ref": "#/$defs/scope"}, "sessionId": {"$ref": "#/$defs/id"}
      }
    }
  }
}
