{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:project-hub:grok-protocol:1",
  "title":"Source-derived closed Grok ACP turn subset",
  "$comment":"Wire shape only, not authentication, readiness or execution authority. Runtime additionally validates strict raw parsing, session/run/prompt binding, canonical request and resolved-input digests, once-only option IDs, immutable reviewed tool identity, cancellation drain restrictions, state, TTL and JSON complexity. Canonical digests do not establish raw-byte identity. Generated from fixed source; not Grok 1.0.50 live evidence.",
  "oneOf":[{"$ref":"#/$defs/permission"},{"$ref":"#/$defs/update"},{"$ref":"#/$defs/result"},{"$ref":"#/$defs/error"},{"$ref":"#/$defs/permissionResponse"},{"$ref":"#/$defs/cancel"}],
  "$defs":{
    "id":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"},
    "rpcId":{"oneOf":[{"$ref":"#/$defs/id"},{"type":"integer","minimum":0,"maximum":9007199254740991}]},
    "text":{"type":"string","maxLength":131072},
    "json":{"oneOf":[{"type":["null","boolean"]},{"type":"number","minimum":-9007199254740991,"maximum":9007199254740991},{"$ref":"#/$defs/text"},{"type":"array","maxItems":16384,"items":{"$ref":"#/$defs/json"}},{"$ref":"#/$defs/object"}]},
    "object":{"type":"object","propertyNames":{"type":"string","maxLength":131072,"not":{"enum":["__proto__","constructor","prototype"]}},"additionalProperties":{"$ref":"#/$defs/json"}},
    "kind":{"enum":["read","edit","delete","move","search","execute","think","fetch","switch_mode","other"]},
    "status":{"enum":["pending","in_progress","completed","failed"]},
    "toolFields":{
      "type":"object","additionalProperties":false,"required":["toolCallId"],
      "properties":{"toolCallId":{"$ref":"#/$defs/id"},"title":{"type":"string","minLength":1,"maxLength":131072},"kind":{"$ref":"#/$defs/kind"},"status":{"$ref":"#/$defs/status"},"content":{"type":"array","maxItems":0},"locations":{"type":"array","maxItems":0},"rawInput":{"$ref":"#/$defs/object"},"rawOutput":{"$ref":"#/$defs/json"},"_meta":{"$ref":"#/$defs/object"}}
    },
    "permissionTool":{"allOf":[{"$ref":"#/$defs/toolFields"},{"properties":{"status":{"const":"pending"}}}],"$comment":"Runtime must resolve a nonempty title and object rawInput from this request plus a previously bound tool notification, and reject any input or pending descriptor change."},
    "option":{"type":"object","additionalProperties":false,"required":["optionId","name","kind"],"properties":{"optionId":{"$ref":"#/$defs/id"},"name":{"type":"string","minLength":1,"maxLength":131072},"kind":{"enum":["allow_once","allow_always","reject_once","reject_always"]},"_meta":{"$ref":"#/$defs/object"}},"allOf":[{"if":{"properties":{"optionId":{"const":"allow-once"}}},"then":{"properties":{"kind":{"const":"allow_once"}}}},{"if":{"properties":{"optionId":{"const":"reject-once"}}},"then":{"properties":{"kind":{"const":"reject_once"}}}}]},
    "permission":{
      "type":"object","additionalProperties":false,"required":["jsonrpc","id","method","params"],
      "properties":{"jsonrpc":{"const":"2.0"},"id":{"$ref":"#/$defs/rpcId"},"method":{"const":"session/request_permission"},"params":{"type":"object","additionalProperties":false,"required":["sessionId","toolCall","options"],"properties":{"sessionId":{"$ref":"#/$defs/id"},"toolCall":{"$ref":"#/$defs/permissionTool"},"options":{"type":"array","minItems":2,"maxItems":16,"items":{"$ref":"#/$defs/option"},"allOf":[{"contains":{"properties":{"optionId":{"const":"allow-once"},"kind":{"const":"allow_once"}},"required":["optionId","kind"]}},{"contains":{"properties":{"optionId":{"const":"reject-once"},"kind":{"const":"reject_once"}},"required":["optionId","kind"]}}]},"_meta":{"$ref":"#/$defs/object"}}}}
    },
    "textUpdate":{"type":"object","additionalProperties":false,"required":["sessionUpdate","content"],"properties":{"sessionUpdate":{"const":"agent_message_chunk"},"content":{"type":"object","additionalProperties":false,"required":["type","text"],"properties":{"type":{"const":"text"},"text":{"$ref":"#/$defs/text"},"_meta":{"$ref":"#/$defs/object"}}},"_meta":{"$ref":"#/$defs/object"}}},
    "toolUpdate":{"type":"object","additionalProperties":false,"required":["sessionUpdate","toolCallId"],"properties":{"sessionUpdate":{"enum":["tool_call","tool_call_update"]},"toolCallId":{"$ref":"#/$defs/id"},"title":{"type":"string","minLength":1,"maxLength":131072},"kind":{"$ref":"#/$defs/kind"},"status":{"$ref":"#/$defs/status"},"content":{"type":"array","maxItems":0},"locations":{"type":"array","maxItems":0},"rawInput":{"$ref":"#/$defs/object"},"rawOutput":{"$ref":"#/$defs/json"},"_meta":{"$ref":"#/$defs/object"}},"allOf":[{"if":{"properties":{"sessionUpdate":{"const":"tool_call"}}},"then":{"required":["title"]}}]},
    "update":{"type":"object","additionalProperties":false,"required":["jsonrpc","method","params"],"properties":{"jsonrpc":{"const":"2.0"},"method":{"const":"session/update"},"params":{"type":"object","additionalProperties":false,"required":["sessionId","update"],"properties":{"sessionId":{"$ref":"#/$defs/id"},"update":{"oneOf":[{"$ref":"#/$defs/textUpdate"},{"$ref":"#/$defs/toolUpdate"}]},"_meta":{"$ref":"#/$defs/object"}}}}},
    "result":{"type":"object","additionalProperties":false,"required":["jsonrpc","id","result"],"properties":{"jsonrpc":{"const":"2.0"},"id":{"$ref":"#/$defs/rpcId"},"result":{"type":"object","additionalProperties":false,"required":["stopReason"],"properties":{"stopReason":{"enum":["end_turn","max_tokens","max_turn_requests","refusal","cancelled"]},"_meta":{"$ref":"#/$defs/object"}}}}},
    "error":{"type":"object","additionalProperties":false,"required":["jsonrpc","id","error"],"properties":{"jsonrpc":{"const":"2.0"},"id":{"$ref":"#/$defs/rpcId"},"error":{"type":"object","additionalProperties":false,"required":["code","message"],"properties":{"code":{"type":"integer","minimum":-2147483648,"maximum":2147483647},"message":{"$ref":"#/$defs/text"},"data":{"$ref":"#/$defs/json"}}}}},
    "permissionResponse":{"type":"object","additionalProperties":false,"required":["jsonrpc","id","result"],"properties":{"jsonrpc":{"const":"2.0"},"id":{"$ref":"#/$defs/rpcId"},"result":{"type":"object","additionalProperties":false,"required":["outcome"],"properties":{"outcome":{"oneOf":[{"type":"object","additionalProperties":false,"required":["outcome","optionId"],"properties":{"outcome":{"const":"selected"},"optionId":{"enum":["allow-once","reject-once"]}}},{"type":"object","additionalProperties":false,"required":["outcome"],"properties":{"outcome":{"const":"cancelled"}}}]}}}}},
    "cancel":{"type":"object","additionalProperties":false,"required":["jsonrpc","method","params"],"properties":{"jsonrpc":{"const":"2.0"},"method":{"const":"session/cancel"},"params":{"type":"object","additionalProperties":false,"required":["sessionId"],"properties":{"sessionId":{"$ref":"#/$defs/id"}}}}}
  }
}
