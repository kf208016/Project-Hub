{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Project Hub handoff and native artifact receipt",
 "description":"Local, resumable offer/receipt reservation. Native HTTP companions require confirmation-time root/FileID bindings and exact rooted cleanup plans, one-time user tokens, exclusive temp journals and fsync. Namespace moves verify before/after trees, with partial receipts retained for review; they do not freeze whole trees.",
 "type":"object","required":["id","project","task"],
 "properties":{
  "id":{"type":"string","format":"uuid"},"project":{"$ref":"#/$defs/id"},"task":{"$ref":"#/$defs/id"},"title":{"type":"string"},"taskHash":{"type":"string"},"targetProject":{"$ref":"#/$defs/id"},"targetTask":{"$ref":"#/$defs/id"},"targetName":{"type":"string"},"targetHash":{"type":"string"},
  "handedUp":{"type":"boolean"},"receiving":{"type":"boolean"},"integrating":{"type":"string","format":"uuid"},"destination":{"type":"string"},"integrated":{"type":["object","null"]},"move":{"type":"array","items":{"type":"object","required":["path"],"properties":{"path":{"type":"string"},"what":{"type":"string"},"fingerprint":{"$ref":"#/$defs/hash"}},"additionalProperties":true}},
  "cleanupVersion":{"const":2},"optional":{"type":"array","items":{"type":"string"}},"notified":{"type":"boolean"},"complete":{"type":"boolean"},"cleanup":{"type":"string","format":"uuid"},"error":{"type":"string"},
  "nativeDestination":{"type":"object","required":["root","rootFingerprint"],"properties":{"root":{"type":"string"},"rootFingerprint":{"$ref":"#/$defs/hash"}},"additionalProperties":false},
  "nativeCleanup":{"type":"object","required":["id","project","task","entries","nativeVersion"],"properties":{"id":{"type":"string","format":"uuid"},"project":{"$ref":"#/$defs/id"},"task":{"$ref":"#/$defs/id"},"title":{"type":"string"},"kind":{"const":"task"},"at":{"type":"string","format":"date-time"},"error":{"type":"string"},"nativeVersion":{"const":1},"entries":{"type":"array","maxItems":100,"items":{"type":"object","required":["from","to","fingerprint","native","moved","restored"],"properties":{"from":{"type":"string"},"to":{"type":"string"},"fingerprint":{"$ref":"#/$defs/hash"},"native":{"$ref":"rooted-move.schema.json"},"moved":{"type":"boolean"},"restored":{"type":"boolean"}},"additionalProperties":false}}},"additionalProperties":false},
  "files":{"type":"array","maxItems":500,"items":{"type":"object","required":["id","path","relative","location","bytes","fingerprint"],"properties":{"id":{"type":"string"},"path":{"type":"string"},"relative":{"type":"string"},"location":{"enum":["project","body"]},"bytes":{"type":"integer","minimum":0,"maximum":67108864},"fingerprint":{"$ref":"#/$defs/hash"},"to":{"type":"string"},"digest":{"$ref":"#/$defs/hash"},"native":{"type":"object","required":["root","rootFingerprint","path","sha256","fileFingerprint"],"properties":{"root":{"type":"string"},"rootFingerprint":{"$ref":"#/$defs/hash"},"path":{"type":"string"},"sha256":{"$ref":"#/$defs/hash"},"fileFingerprint":{"$ref":"#/$defs/hash"}},"additionalProperties":false},"copyReceipt":{"type":"object","required":["sha256","fileFingerprint"],"properties":{"sha256":{"$ref":"#/$defs/hash"},"fileFingerprint":{"$ref":"#/$defs/hash"}},"additionalProperties":false},"copyState":{"enum":["copying","copied"]}},"additionalProperties":false}}
 },
