{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-hub:claude-protocol:v1",
  "title": "Offline Claude protocol closed subset v1",
  "$comment": "Authored from anthropics/claude-agent-sdk-python@615d88b9baebfe155263fbdd2ca22cecc1da3430 (bundled CLI 2.1.252). Synthetic contract fixtures only; no live stream compatibility, authentication, isolation or readiness attestation. Runtime also enforces byte, depth, node, state, session, replay, clock and authority constraints.",
  "oneOf": [
    {"$ref": "#/$defs/init"}, {"$ref": "#/$defs/permissionRequest"}, {"$ref": "#/$defs/cancelRequest"},
    {"$ref": "#/$defs/assistant"}, {"$ref": "#/$defs/stream"}, {"$ref": "#/$defs/result"}, {"$ref": "#/$defs/permissionResponse"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$", "maxLength": 256},
    "text": {"type": "string", "maxLength": 131072, "pattern": "^[^\\u0000]*$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "json": {"anyOf": [
      {"$ref": "#/$defs/text"}, {"type": "boolean"}, {"type": "null"},
      {"type": "number", "minimum": -9007199254740991, "maximum": 9007199254740991},
      {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/json"}}, {"$ref": "#/$defs/jsonObject"}
    ]},
    "jsonObject": {
      "type": "object", "maxProperties": 16384,
      "propertyNames": {"not": {"enum": ["__proto__", "constructor", "prototype"]}},
      "additionalProperties": {"$ref": "#/$defs/json"}
    },
    "init": {
      "type": "object", "additionalProperties": false, "required": ["type", "subtype", "session_id", "uuid"],
      "properties": {
        "type": {"const": "system"}, "subtype": {"const": "init"}, "session_id": {"$ref": "#/$defs/id"}, "uuid": {"$ref": "#/$defs/id"},
        "model": {"type": "string", "minLength": 1, "maxLength": 131072}, "cwd": {"type": "string", "minLength": 1, "maxLength": 131072},
        "tools": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/id"}},
        "permissionMode": {"enum": ["default", "manual", "plan", "dontAsk"]}
      }
    },
    "permissionRequest": {
      "type": "object", "additionalProperties": false, "required": ["type", "request_id", "request"],
      "properties": {
        "type": {"const": "control_request"}, "request_id": {"$ref": "#/$defs/id"},
        "request": {
          "type": "object", "additionalProperties": false, "required": ["subtype", "tool_name", "input", "tool_use_id"],
          "properties": {
            "subtype": {"const": "can_use_tool"}, "tool_name": {"$ref": "#/$defs/id"}, "input": {"$ref": "#/$defs/jsonObject"}, "tool_use_id": {"$ref": "#/$defs/id"},
            "permission_suggestions": {"anyOf": [{"type": "null"}, {"type": "array", "maxItems": 0}]},
            "blocked_path": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}, "decision_reason": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
            "title": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}, "display_name": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}, "description": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}, "agent_id": {"type": "null"}
          }
        }
      }
    },
    "cancelRequest": {
      "type": "object", "additionalProperties": false, "required": ["type", "request_id"],
      "properties": {"type": {"const": "control_cancel_request"}, "request_id": {"$ref": "#/$defs/id"}}
    },
    "block": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": {"type": {"const": "text"}, "text": {"$ref": "#/$defs/text"}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "id", "name", "input"], "properties": {"type": {"const": "tool_use"}, "id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/id"}, "input": {"$ref": "#/$defs/jsonObject"}}}
    ]},
    "startBlock": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": {"type": {"const": "text"}, "text": {"const": ""}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "id", "name", "input"], "properties": {"type": {"const": "tool_use"}, "id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/id"}, "input": {"type": "object", "maxProperties": 0, "additionalProperties": false}}}
    ]},
    "message": {
      "type": "object", "additionalProperties": false, "required": ["id", "role", "model", "content"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "type": {"const": "message"}, "role": {"const": "assistant"}, "model": {"type": "string", "minLength": 1, "maxLength": 131072},
        "content": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/block"}},
        "stop_reason": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}, "stop_sequence": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}, "usage": {"$ref": "#/$defs/jsonObject"}
      }
    },
    "assistant": {
      "type": "object", "additionalProperties": false, "required": ["type", "session_id", "uuid", "message"],
      "properties": {
        "type": {"const": "assistant"}, "session_id": {"$ref": "#/$defs/id"}, "uuid": {"$ref": "#/$defs/id"}, "message": {"$ref": "#/$defs/message"},
        "parent_tool_use_id": {"type": "null"}, "error": {"type": "null"}
      }
    },
    "stream": {
      "type": "object", "additionalProperties": false, "required": ["type", "uuid", "session_id", "event"],
      "properties": {"type": {"const": "stream_event"}, "uuid": {"$ref": "#/$defs/id"}, "session_id": {"$ref": "#/$defs/id"}, "parent_tool_use_id": {"type": "null"}, "event": {"$ref": "#/$defs/streamEvent"}}
    },
    "streamEvent": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["type", "message"], "properties": {
        "type": {"const": "message_start"}, "message": {
          "type": "object", "additionalProperties": false, "required": ["id", "type", "role", "model", "content"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"const": "message"}, "role": {"const": "assistant"}, "model": {"type": "string", "minLength": 1, "maxLength": 131072}, "content": {"type": "array", "maxItems": 0}, "stop_reason": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}, "stop_sequence": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}, "usage": {"$ref": "#/$defs/jsonObject"}}
        }
      }},
      {"type": "object", "additionalProperties": false, "required": ["type", "index", "content_block"], "properties": {"type": {"const": "content_block_start"}, "index": {"$ref": "#/$defs/count"}, "content_block": {"$ref": "#/$defs/startBlock"}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "index", "delta"], "properties": {"type": {"const": "content_block_delta"}, "index": {"$ref": "#/$defs/count"}, "delta": {"oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": {"type": {"const": "text_delta"}, "text": {"$ref": "#/$defs/text"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "partial_json"], "properties": {"type": {"const": "input_json_delta"}, "partial_json": {"$ref": "#/$defs/text"}}}
      ]}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "index"], "properties": {"type": {"const": "content_block_stop"}, "index": {"$ref": "#/$defs/count"}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "delta", "usage"], "properties": {"type": {"const": "message_delta"}, "delta": {
        "type": "object", "additionalProperties": false, "required": ["stop_reason", "stop_sequence"], "properties": {"stop_reason": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}, "stop_sequence": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}}
      }, "usage": {"$ref": "#/$defs/jsonObject"}}},
      {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "message_stop"}}}
    ]},
    "result": {
      "type": "object", "additionalProperties": false, "required": ["type", "subtype", "session_id", "uuid", "duration_ms", "duration_api_ms", "is_error", "num_turns"],
      "properties": {
        "type": {"const": "result"}, "subtype": {"enum": ["success", "error_during_execution", "error_max_turns", "error_max_budget_usd", "error_max_structured_output_retries"]},
        "session_id": {"$ref": "#/$defs/id"}, "uuid": {"$ref": "#/$defs/id"}, "duration_ms": {"$ref": "#/$defs/count"}, "duration_api_ms": {"$ref": "#/$defs/count"}, "is_error": {"type": "boolean"}, "num_turns": {"$ref": "#/$defs/count"},
        "result": {"$ref": "#/$defs/text"}, "errors": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/text"}}, "terminal_reason": {"$ref": "#/$defs/id"},
        "stop_reason": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}, "total_cost_usd": {"type": "number", "minimum": 0, "maximum": 9007199254740991},
        "usage": {"$ref": "#/$defs/jsonObject"}, "modelUsage": {"$ref": "#/$defs/jsonObject"}, "permission_denials": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/json"}}, "api_error_status": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 100, "maximum": 599}]}
      }
    },
    "permissionResponse": {
      "type": "object", "additionalProperties": false, "required": ["type", "response"],
      "properties": {
        "type": {"const": "control_response"}, "response": {
          "type": "object", "additionalProperties": false, "required": ["subtype", "request_id", "response"],
          "properties": {"subtype": {"const": "success"}, "request_id": {"$ref": "#/$defs/id"}, "response": {"oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["behavior", "updatedInput"], "properties": {"behavior": {"const": "allow"}, "updatedInput": {"$ref": "#/$defs/jsonObject"}}},
            {"type": "object", "additionalProperties": false, "required": ["behavior", "message"], "properties": {"behavior": {"const": "deny"}, "message": {"const": "Denied by Hub owner"}}}
          ]}}
        }
      }
    }
  }
}
