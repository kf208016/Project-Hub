{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-hub:worker-stage:v1",
  "title": "Private CLI stage client requests (no execution operation)",
  "oneOf": [
    {"type":"object","additionalProperties":false,"required":["protocol","nonce","sequence","op","bundleSHA256"],"properties":{"protocol":{"const":1},"nonce":{"$ref":"#/$defs/nonce"},"sequence":{"$ref":"#/$defs/sequence"},"op":{"enum":["hello","begin","commit"]},"bundleSHA256":{"$ref":"#/$defs/sha256"}}},
    {"type":"object","additionalProperties":false,"required":["protocol","nonce","sequence","op","path"],"properties":{"protocol":{"const":1},"nonce":{"$ref":"#/$defs/nonce"},"sequence":{"$ref":"#/$defs/sequence"},"op":{"const":"file-begin"},"path":{"enum":["bin/claude","bin/grok","bin/socat","lib/libwrap.so.0","notices/socat.txt","notices/libwrap0.txt"]}}},
    {"type":"object","additionalProperties":false,"required":["protocol","nonce","sequence","op","data"],"properties":{"protocol":{"const":1},"nonce":{"$ref":"#/$defs/nonce"},"sequence":{"$ref":"#/$defs/sequence"},"op":{"const":"file-chunk"},"data":{"type":"string","minLength":1,"maxLength":349528,"pattern":"^[A-Za-z0-9+/]+={0,2}$"}}}
  ],
  "$defs": {
    "nonce":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "sequence":{"type":"integer","minimum":1,"maximum":2147483647}
  },
  "$comment":"Runtime additionally enforces exact nonce, ordered sequence/state, fixed bundle SHA and exact artifact bytes/hash. All text must be Unicode scalar values without NUL; floating point values and duplicate JSON keys are rejected. A completed stage does not enable provider execution."
}
