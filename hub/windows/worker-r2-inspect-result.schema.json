{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "op",
    "sequence",
    "nonce",
    "uid",
    "bootId",
    "ok",
    "code",
    "records",
    "unit",
    "cgroup",
    "cleanupHistorical",
    "providerReady",
    "snapshotAtomic"
  ],
  "properties": {
    "protocol": {
      "const": 1
    },
    "op": {
      "const": "inspection-result"
    },
    "sequence": {
      "const": 1
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "uid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "bootId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "ok": {
      "type": "boolean"
    },
    "code": {
      "type": "string",
      "enum": [
        "OK",
        "NOT_READ",
        "MISSING",
        "JSON_REJECTED",
        "SCHEMA_REJECTED",
        "BINDING_REJECTED",
        "METADATA_REJECTED",
        "IDENTITY_CHANGED",
        "CONTENT_CHANGED",
        "SIZE_BOUND",
        "TOTAL_BOUND",
        "IO_REJECTED",
        "LINUX_REQUIRED",
        "ROOT_REJECTED",
        "DEADLINE",
        "REQUEST_REJECTED",
        "REQUEST_EXPIRED",
        "BOOT_REJECTED",
        "UID_REJECTED",
        "RECEIPT_REJECTED",
        "LEASE_REJECTED",
        "RUNTIME_REJECTED",
        "TOOL_FAILED",
        "TOOL_OUTPUT_BOUND",
        "UNIT_REJECTED",
        "UNIT_MISSING",
        "SAVED_IDENTITY_UNAVAILABLE",
        "UNIT_IDENTITY_CHANGED",
        "CGROUP_REJECTED",
        "CGROUP_MISSING",
        "CGROUP_IDENTITY_CHANGED",
        "INSPECTION_FAILED",
        "PARTIAL",
        "OUTPUT_REJECTED"
      ]
    },
    "records": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/record"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "intent.json"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/record"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "runtime.json"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/record"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "unit.json"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/record"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "service-kernel.json"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/record"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "execution-gate.json"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/record"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "service-error.json"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/record"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "measurement.json"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/record"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "result.json"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/record"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "closed.json"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/record"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "active.json"
                }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "unit": {
      "$ref": "#/$defs/unit"
    },
    "cgroup": {
      "$ref": "#/$defs/cgroup"
    },
    "cleanupHistorical": {
      "const": "unknown"
    },
    "providerReady": {
      "const": false
    },
    "snapshotAtomic": {
      "const": false
    }
