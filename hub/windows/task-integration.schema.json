{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Native hierarchy integration journal version 1",
 "description":"Private confirmation-bound plans. All reviewed Git merges run grandchildren first with exact target receipt advancement; receive/native cleanup follows grandchildren first. Complete flags alone are not completion evidence.",
 "type":"object","additionalProperties":false,
 "required":["id","at","project","task","target","items","complete","nativeVersion","nativeDestination"],
 "properties":{
  "id":{"type":"string","format":"uuid"},"at":{"type":"string","format":"date-time"},"project":{"$ref":"#/$defs/id"},"task":{"$ref":"#/$defs/id"},"target":{"type":"string","minLength":4},"complete":{"type":"boolean"},"error":{"type":"string"},"nativeVersion":{"const":1},
  "nativeDestination":{"$ref":"task-handoff.schema.json#/properties/nativeDestination"},
  "items":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"object","additionalProperties":false,
   "required":["project","task","title","taskHash","copy","files","selected","descendants","move","optional","state","nativeCleanup"],
   "properties":{
    "project":{"$ref":"#/$defs/id"},"task":{"$ref":"#/$defs/id"},"title":{"type":"string"},"taskHash":{"type":"string"},"route":{"type":"string"},"depth":{"type":"integer","minimum":1},"handedUp":{"type":"boolean"},
    "copy":{"type":["string","null"]},"source":{"type":["object","null"]},"preview":{"type":["object","null"]},"integrated":{"type":["object","null"]},
    "files":{"$ref":"task-handoff.schema.json#/properties/files","items":{"required":["native"]}},"selected":{"type":"array","items":{"type":"string"}},"descendants":{"type":"array","items":{"type":"object","required":["project","task","title","finished"],"properties":{"project":{"$ref":"#/$defs/id"},"task":{"$ref":"#/$defs/id"},"title":{"type":"string"},"finished":{"type":"boolean"}},"additionalProperties":false}},
    "blockers":{"type":"array","items":{"type":"string"}},"move":{"$ref":"task-handoff.schema.json#/properties/move"},"optional":{"type":"array","items":{"type":"string"}},"keep":{"type":"array"},"overlaps":{"type":"array","items":{"type":"string"}},"branch":{"type":["string","null"]},"state":{"enum":["待ち","衝突","取り込み済み","片付け済み"]},
    "nativeCleanup":{"$ref":"native-cleanup.schema.json"},"gitExecution":{"$ref":"merge-record.schema.json#/properties/gitExecution"},"sourceSnapshot":{"type":["object","null"]},"sourceHead":{"type":"string","pattern":"^[a-f0-9]{40,64}$"},"copyTrashPlanned":{"type":"string"},"copyTrashed":{"type":"string"},"receipt":{"type":"string","format":"uuid"},"mergeRecordId":{"type":"string","format":"uuid"}
   }
  }}
 },
 "$defs":{"id":{"type":"string","minLength":1,"maxLength":255,"pattern":"^[^\\\\/\\u0000]+$"}},
 "allOf":[{"if":{"properties":{"complete":{"const":true}}},"then":{"properties":{"items":{"items":{"properties":{"state":{"const":"片付け済み"}},"required":["receipt"]}}}}}]
}
