{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Windows browser reviewed standalone command intent",
  "description": "A process-local execute-once intent. Requesting via MCP is not approval. Codex sandbox read access is broader than task cwd and networkAccess=false is not a complete network boundary.",
  "$defs": {
    "hash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "argv": {"type":"array","minItems":1,"maxItems":128,"items":{"type":"string","maxLength":8192,"pattern":"^[^\\u0000]*$"}},
    "request": {
      "type":"object","additionalProperties":false,"required":["argv","cwd","expectedHash"],
      "properties":{"argv":{"$ref":"#/$defs/argv"},"cwd":{"type":"string","minLength":4,"maxLength":32768},"expectedHash":{"$ref":"#/$defs/hash"},"timeoutMs":{"type":"integer","minimum":100,"maximum":120000,"default":30000}}
    },
    "decision": {
      "type":"object","additionalProperties":false,"required":["id","decision","confirm"],
      "properties":{"id":{"type":"string","format":"uuid"},"decision":{"enum":["approve","decline"]},"confirm":{"const":true},"ackBroaderRead":{"const":true},"ackNetworkLimits":{"const":true},"argv":{"$ref":"#/$defs/argv"},"cwd":{"type":"string"},"expectedHash":{"$ref":"#/$defs/hash"},"rootFingerprint":{"$ref":"#/$defs/hash"}},
      "allOf":[{"if":{"properties":{"decision":{"const":"approve"}}},"then":{"required":["ackBroaderRead","ackNetworkLimits","argv","cwd","expectedHash","rootFingerprint"]}}]
    },
    "state": {"enum":["pending","validating","running","canceling","completed","failed","expired","declined","canceled"]},
    "capId": {"type":"string","format":"uuid"},
    "outcome": {"enum":["success","failure","canceled"]}
  },
  "$ref":"#/$defs/request"
}
